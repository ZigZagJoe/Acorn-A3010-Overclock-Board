	(text "Intent: turn on-off-on switch into off-on-on logically\nBuffer also used to allow switch to be located remotely\nNot intended for live switching.\n\nON1 = Nada\nOff = OSC\nON2 = EXT_OSC\n\nON1 = ENABLE_OSC forced high via buffer 1, no output \nOff = ENABLE_OSC pulled low, output = OSC,\nON2 = ENABLE_OSC forced high via buffer 4, SW_P2 = GND to output = EXT_OSC"
		(exclude_from_sim no)
		(at 21.082 88.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "2752ea24-d2c3-4e4c-85b2-9c75bad351c2")
	)
	(text "pull down so this is default \nwhen both SW_P* are pulled high"
		(exclude_from_sim no)
